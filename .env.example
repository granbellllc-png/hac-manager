# Application configuration. Paths refer to directories outside the app checkout.
HACM_DATA_DIR=/path/to/your/infra-repo
HACM_STATE_DIR=/path/to/your/hacm-state
# Bind to loopback by default; use a trusted reverse proxy for HTTPS.
HACM_HOST=127.0.0.1
HACM_PORT=3000
HACM_LOG_LEVEL=info
# Optional compiled SPA directory (empty disables static serving).
HACM_WEB_DIR=
# Future modules: secret cache lifetime, concurrency, and cookie hardening.
HACM_SECRET_TTL_SECONDS=300
HACM_HOST_CONCURRENCY=2
HACM_SESSION_SECRET=replace-with-a-random-secret-before-deployment
HACM_COOKIE_SECURE=true
HACM_PROTECTED_HOST_ID=
HACM_PROTECTED_GUEST_ID=

# Variables referenced by the fake example data. Supply your own untracked values.
EXAMPLE_SSH_PRIVATE_KEY=
EXAMPLE_API_TOKEN=
EXAMPLE_API_CA_FILE=
EXAMPLE_GATEWAY=192.0.2.1
