{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "dev": "pnpm --filter @hacm/core build && tsx watch --env-file-if-exists=../../.env scripts/dev.ts",
    "start": "node --env-file-if-exists=../../.env bin/server.mjs",
    "openapi:generate": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "@fastify/websocket": "11.3.7",
    "@hacm/core": "workspace:*",
    "argon2": "0.45.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "ssh2": "1.17.0",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/qrcode": "1.5.6",
    "@types/ssh2": "1.15.6"
  }
}
